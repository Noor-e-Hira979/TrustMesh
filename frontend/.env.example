# ---------------------------------------------------------------- frontend
# Base URL of the TrustMesh control plane.
#
# LEAVE EMPTY for local development: the Vite dev server proxies /api to
# http://127.0.0.1:8000 (see vite.config.js), so the browser sees one origin and SSE
# needs no CORS preflight.
#
# SET IT for any deployment where the API is hosted separately from the page - which is
# the normal production case (SPA on Vercel, API on Render / Cloud Run). Without this the
# frontend would call <its-own-domain>/api/... and 404 on every request, including the
# event stream.
#
# Vite inlines VITE_* variables at BUILD time, so this must be set in the platform's
# build environment variables and the project redeployed for a change to take effect.
#
#   Vercel      : Project > Settings > Environment Variables > VITE_API_URL
#   Netlify     : Site settings > Environment variables
#   Cloud Pages  : build command `VITE_API_URL=https://... npm run build`
VITE_API_URL=

# Target for the local dev-server proxy only. Ignored in production builds.
VITE_API_TARGET=http://127.0.0.1:8000
