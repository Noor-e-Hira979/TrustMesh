# ------------------------------------------------------------------ Hardhat
# Local development node used by `npm run node` and `npm run deploy:localhost`.
RPC_URL=http://127.0.0.1:8545

# ------------------------------------------------- public EVM testnet (free)
# Sepolia (Ethereum)
#   RPC     : https://ethereum-sepolia-rpc.publicnode.com
#   Faucet  : https://sepoliafaucet.com
#   Chain ID: 11155111
#
# Amoy (Polygon)
#   RPC     : https://rpc-amoy.polygon.technology
#   Faucet  : https://faucet.polygon.technology
#   Chain ID: 80002
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_CHAIN_ID=11155111

# Deployer key. NEVER commit a funded key and never reuse one that holds real funds.
# A Hardhat default dev key is fine for a throwaway local node.
#   npx hardhat node   prints the funded development accounts
BLOCKCHAIN_PRIVATE_KEY=

# --------------------------------------------------------------- deployment
# Written after `npm run deploy`; copy into backend/.env as well.
TRUSTMESH_REGISTRY_ADDRESS=
