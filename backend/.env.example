# ------------------------------------------------------------------ app
APP_NAME=TrustMesh
APP_ENV=demo
DEBUG=true
API_PREFIX=/api

# Comma separated list of allowed origins (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------- database
# Leave unset to use ./trustmesh.db next to this file.
# DATABASE_URL=sqlite:///./trustmesh.db

# --------------------------------------------------------------------- ai
# Optional. Without it, TrustMesh runs in deterministic Demo Mode: the AI layer falls
# back to the constraint solver and the demo behaves identically.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_ATTEMPTS=2
AI_ENABLED=true

# -------------------------------------------------------------- blockchain
# Public EVM testnet. Free RPC + free faucet.
#   Sepolia : https://ethereum-sepolia-rpc.publicnode.com
#   Amoy    : https://rpc-amoy.polygon.technology
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_RPC_URL=
# Deploy contracts/ then paste the deployed address here.
BLOCKCHAIN_CONTRACT_ADDRESS=
# Backend-only. NEVER commit a real key, NEVER expose it to the frontend.
# A local Hardhat default dev key is fine for a throwaway demo node.
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATIONS_REQUIRED=1
BLOCKCHAIN_TIMEOUT_SECONDS=30
BLOCKCHAIN_GAS_LIMIT=220000
# auto      -> live when an RPC is configured, otherwise SIMULATED (clearly labelled)
# live      -> require an RPC; failures produce FAILED commitments
# simulated -> never touch the network; deterministic simulated receipts
BLOCKCHAIN_MODE=auto
BLOCKCHAIN_SIMULATED_LATENCY_SECONDS=1.2

# --------------------------------------------------------------- security
# HMAC secret for credential digests. A dev fallback is used if unset.
CREDENTIAL_HMAC_SECRET=

# ----------------------------------------------------------------- events
EVENT_BUFFER_SIZE=500
EVENT_HEARTBEAT_SECONDS=15
EVENT_PERSIST_LIMIT=5000

# ------------------------------------------------------------------- demo
DEMO_STEP_DELAY_SECONDS=0.55
RESET_ON_BOOT=false
